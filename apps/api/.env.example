# แอปใช้บัญชีที่อ่าน/เขียนข้อมูลได้อย่างเดียว (สร้างด้วย scripts/db-app-role.sql) · migrate ใช้บัญชีเจ้าของ schema
DATABASE_URL=postgresql://csis_app:CHANGE_ME@127.0.0.1:5434/csis
MIGRATION_DATABASE_URL=postgresql://csis:csis_dev_only@127.0.0.1:5434/csis
PORT=4010
# เว็บที่อนุญาตให้ส่งคำขอแก้ไขข้อมูล (ตรวจ Origin กัน CSRF)
WEB_ORIGIN=http://localhost:3010
# production ต้องเป็น true (คุกกี้ Secure ส่งผ่าน HTTPS เท่านั้น)
COOKIE_SECURE=false
SESSION_DAYS=7

# true = นักเรียนต้องเปลี่ยนรหัสวันเกิดตอนล็อกอินครั้งแรก, false = ใช้วันเกิดต่อได้ (เจ้าหน้าที่ถูกบังคับเสมอ)
STUDENT_FORCE_PASSWORD_CHANGE=false
